<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>VIRA Label Printing</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="page">
    <header>
      <p class="eyebrow">VIRA</p>
      <h1>Label Printing</h1>
      <p class="intro">Enter the shipment details and select the approved printer and label template.</p>
    </header>

    <% if (errorMessage) { %>
      <section class="notice" role="alert"><%= errorMessage %></section>
    <% } else { %>
      <form>
        <div class="grid">
          <label>Printer
            <select name="printer" required>
              <option value="" disabled <%= selectedPrinterId ? '' : 'selected' %>>Select a printer</option>
              <% printers.forEach((printer) => { %><option value="<%= printer._id %>" <%= printer._id === selectedPrinterId ? 'selected' : '' %>><%= printer.name || printer._id %></option><% }); %>
            </select>
          </label>
          <label>Label Template
            <select name="label" required>
              <option value="" disabled <%= selectedLabelId ? '' : 'selected' %>>Select a label template</option>
              <% labels.forEach((label) => { %><option value="<%= label._id %>" <%= label._id === selectedLabelId ? 'selected' : '' %>><%= label.name || label._id %></option><% }); %>
            </select>
          </label>
          <label>Part No
            <input name="partNo" type="text" required maxlength="100" placeholder="163-0002-001">
          </label>
          <label>Description
            <textarea name="description" required maxlength="500" rows="3" placeholder="CVS Beauty Creations Hybrid Endcap - Graphic Prints_Samples"></textarea>
          </label>
          <label>Qty
            <input name="qty" type="number" required min="1" step="1" placeholder="70">
          </label>
          <label>Attn
            <input name="attn" type="text" required maxlength="100" placeholder="Amanda Burkey">
          </label>
          <label>Shipping Date
            <input name="shippingDate" type="date" required>
          </label>
          <label>Copies
            <input name="copies" type="number" required min="1" step="1" value="1">
          </label>
          <div id="dynamic-fields"></div>
        </div>
        <div class="actions"><button type="button" id="preview">Preview</button><button type="submit" id="print">Print</button></div>
        <p id="status" role="status"></p>
        <img id="preview-image" alt="Label preview">
        <section><h2>My print history</h2><div id="history"></div></section>
      </form>
    <% } %>
  </main>
  <% if (!errorMessage) { %>
    <script>
      const printer = document.querySelector('select[name="printer"]');
      const label = document.querySelector('select[name="label"]');
      const form = document.querySelector('form');
      const status = document.querySelector('#status');
      const dynamic = document.querySelector('#dynamic-fields');
      let fieldNames = [];
      const payload = () => ({ printer: printer.value, label: label.value, copies: document.querySelector('[name="copies"]').value, data: Object.fromEntries(fieldNames.map((name) => { const input = [...form.elements].find((element) => element.name === name); return [name, input.value]; })) });
      const api = async (url, options) => { const response = await fetch(url, options); const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Request failed.'); return data; };
      printer.addEventListener('change', (event) => { fetch('/preferences/printer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ printer: event.target.value }) }); });
      async function loadFields() { try { const data = await api(`/form-fields/${encodeURIComponent(label.value)}`); fieldNames = data.fields; dynamic.innerHTML = ''; data.fields.forEach((name) => { if ([...form.elements].some((element) => element.name === name)) return; const field = document.createElement('label'); field.textContent = name; const input = document.createElement('input'); input.name = name; input.required = true; input.maxLength = 500; field.append(input); dynamic.append(field); }); } catch (error) { status.textContent = error.message; } }
      label.addEventListener('change', () => { fetch('/preferences/label', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ label: label.value }) }); loadFields(); });
      if (label.value) loadFields();
      document.querySelector('#preview').addEventListener('click', async () => { if (!form.reportValidity()) return; try { const data = await api('/preview', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload()) }); document.querySelector('#preview-image').src = `data:image/png;base64,${data.img}`; status.textContent = ''; } catch (error) { status.textContent = error.message; } });
      form.addEventListener('submit', async (event) => { event.preventDefault(); if (!form.reportValidity()) return; try { const data = await api('/print', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload()) }); status.textContent = `${data.jobs.length} print job(s) sent.`; history(); } catch (error) { status.textContent = error.message; } });
      async function history() { try { const jobs = await api('/history'); const box = document.querySelector('#history'); box.innerHTML = ''; jobs.forEach((job) => { const button = document.createElement('button'); button.type = 'button'; button.textContent = `${job.date}: ${job.label_name}`; button.onclick = async () => { printer.value = job.printer_id; label.value = job.label_id; await loadFields(); Object.entries(job.data).forEach(([name, value]) => { const input = [...form.elements].find((element) => element.name === name); if (input) input.value = value; }); }; box.append(button); }); } catch (error) { status.textContent = error.message; } }
      history();
    </script>
  <% } %>
</body>
</html>
